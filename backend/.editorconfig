root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
file_scoped_namespace_declarations = true:warning
csharp_style_namespace_declarations = file_scoped:warning

# ---------- Excepciones justificadas a los analizadores (AnalysisLevel = latest-recommended) ----------

# "Error" choca con una palabra reservada de VB. La API solo se consume desde C# y el nombre es el más claro.
dotnet_diagnostic.CA1716.severity = none

# "ProductAttribute" es un concepto del dominio (atributo de producto), no un atributo de .NET.
dotnet_diagnostic.CA1711.severity = none

# Migraciones: las genera dotnet-ef; no se editan a mano ni se analizan.
[**/Infrastructure/Persistence/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Consultas LINQ de EF Core: string.ToLower() y Contains(string) se traducen a LOWER()/LIKE de SQL.
# Las sobrecargas con CultureInfo o StringComparison que piden estas reglas no son traducibles.
[**/Features/**/*{Queries,Service}.cs]
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1862.severity = none
